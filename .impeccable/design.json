  "narrative": {
    "northStar": "Inspectable scientific evidence",
    "overview": "The confirmed world is a white and light-gray scientific SaaS interface. Compact controls, fine dividing rules, dense tables, and clear numeric hierarchy support researchers inspecting a query and its evidence. This name describes the shipped and user-approved direction; it is not a retrospective concept workshop.\n\nWhite panels sit on a cool gray canvas. Blue marks actions, active navigation, linked evidence, and primary charts. Dark text carries the content; gray supports provenance and scope. The bundled Inter family provides one consistent voice across interface and charts, with Chinese text using the declared fallback stack.",
    "keyCharacteristics": [
      "Flat white panels with fine gray borders and gently curved corners.",
      "Dense evidence displays with distinct full-query and recent-sample scope.",
      "One type family, restrained blue actions, and supporting cyan data geometry.",
      "Responsive stacking and local table scrolling.",
      "Keyboard-visible controls and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Evidence Blue Rule",
        "body": "Use blue for actions, selected navigation, references, and primary data emphasis, following the existing semantic assignments.",
        "section": "colors"
      },
      {
        "name": "The Numeric Scan Rule",
        "body": "Keep KPI values and numeric table columns tabular; align journal count columns to the right.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Use borders and tonal surfaces for panel separation; reserve the observed lift for the floating explanation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the white/light-gray scientific SaaS world, bundled Inter, and panel radius.",
      "Do use blue consistently for actions, selected navigation, references, and primary data.",
      "Do keep full-query counts visibly distinct from recent-sample statistics.",
      "Do retain keyboard focus, accessible control labels, and reduced-motion behavior.",
      "Do use local scrolling for wide paper tables and stack analytic panels at the observed breakpoints.",
      "Do retain the requested research-direction and brief numbering in those content structures."
    ],
    "donts": [
      "Don't add ambient panel shadows to the flat panel vocabulary.",
      "Don't turn local chart colors into unrelated interface accents.",
      "Don't turn the research numbering into decorative kickers or numbered methodology headings.",
      "Don't present missing values as fabricated data."
    ]
  }
}
